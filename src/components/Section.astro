---
import styles from './Section.module.scss';

interface Props {
  id: string;
  number: string;
  title: string;
}

const { id, number, title } = Astro.props;

// Keep hyphenated words like "non-engineers" whole in the narrow desktop heading column,
// without changing the copy itself.
const words = title.split(' ');
---

<section id={id} class={styles.section} aria-labelledby={`${id}-heading`} data-island-section>
  <header class={styles.header}>
    <p class={styles.number} aria-hidden="true">
      {number}
    </p>
    <h2 id={`${id}-heading`} class={styles.title} tabindex="-1">
      {words.map((word, index) => (
        <>
          {index > 0 && ' '}
          {word.includes('-') ? <span class={styles.nowrap}>{word}</span> : word}
        </>
      ))}
    </h2>
    {/* Only shown on the map, where each section opens as a panel. */}
    <button type="button" class={styles.close} data-island-close>
      Back to the map
    </button>
  </header>
  <div class={styles.body}>
    <slot />
  </div>
</section>
