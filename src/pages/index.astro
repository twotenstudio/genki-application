---
import AgentWork from '../components/AgentWork.astro';
import ArchitecturalBet from '../components/ArchitecturalBet.astro';
import Intro from '../components/Intro.astro';
import Links from '../components/Links.astro';
import Projects from '../components/Projects.astro';
import Section from '../components/Section.astro';
import ShipSafely from '../components/ShipSafely.astro';
import ViewToggle from '../components/ViewToggle.astro';
import World from '../components/World.astro';
import { section } from '../data/sections';
import Base from '../layouts/Base.astro';
---

<Base
  title="Liam Trubshaw, Lead Web Engineer application for Genki"
  description="Liam Trubshaw's application for Lead Web Engineer at Genki: what I've built, an architectural bet I lived with, and how I work with AI agents."
>
  <main>
    <ViewToggle />
    <Intro />
    <World />
    <Section {...section('built')}>
      <Projects />
    </Section>
    <Section {...section('bet')}>
      <ArchitecturalBet />
    </Section>
    <Section {...section('agents')}>
      <AgentWork />
    </Section>
    <Section {...section('ship-safely')}>
      <ShipSafely />
    </Section>
    <Section {...section('links')}>
      <Links />
    </Section>
  </main>
</Base>
